# LLM provider 的密钥放这里，由 llm.yaml 通过 ${ENV} 引用。
# 启用哪个 provider 看 llm.yaml 的 active（或用 LLM_PROVIDER 覆盖），
# 只需填你实际启用的那个 key。

# Anthropic（默认 provider）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# OpenAI（启用 openai provider 时填）
OPENAI_API_KEY=sk-xxxxxxxx

# DeepSeek（启用 deepseek provider 时填）
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 覆盖 llm.yaml 里的 active（可选）：anthropic / openai / deepseek
# LLM_PROVIDER=deepseek

# 后端服务地址（前端用，可选）
BACKEND_URL=http://127.0.0.1:8000

# SQLite 数据库路径（可选）
DATABASE_URL=sqlite:///./crm.db

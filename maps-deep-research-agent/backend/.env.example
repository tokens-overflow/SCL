# ============================================================
# LLM Provider Keys（具体 provider/model 在 LLMConfig.yaml 中切换）
# ============================================================

# DeepSeek（默认使用）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Anthropic（type: anthropic 或 type: bedrock 时使用）
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# AWS Bedrock（type: bedrock 时使用）
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ============================================================
# LLM Config（可选，默认加载 backend/LLMConfig.yaml）
# ============================================================
# LLM_CONFIG_PATH=LLMConfig.yaml

# ============================================================
# Google Maps Platform
# ============================================================
GOOGLE_MAPS_API_KEY=AIzaSy-your-google-maps-server-key
# 默认搜索半径（米），仅用于 nearby 模式
GOOGLE_MAPS_DEFAULT_RADIUS=3000
# 默认返回结果数（Places）
GOOGLE_MAPS_PLACES_LIMIT=8

# ============================================================
# Agent 行为
# ============================================================
# 默认每个研究主题最多拆解多少子任务
MAX_TASKS=5
# 默认任务并发度
TASK_CONCURRENCY=3
# 默认输出语言 (zh / en)
DEFAULT_LANGUAGE=zh

# ============================================================
# 缓存
# ============================================================
CACHE_DIR=./.cache/maps
CACHE_TTL_SECONDS=86400

# ============================================================
# Server
# ============================================================
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

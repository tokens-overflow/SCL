# ============================================================
# DeepSeek
# ============================================================
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选模型:
#   deepseek-v4-pro   — Pro 版，支持 reasoning_effort 和 thinking 参数（推荐）
#   deepseek-v4-flash — Flash 版，速度快/成本低，不传 reasoning 参数
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_TIMEOUT=60

# Reasoning / Thinking（仅对 deepseek-v4-pro 生效）
# DEEPSEEK_REASONING_EFFORT 可选值: high | medium | low | ""（空字符串 = 关闭）
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_ENABLED=true

# ============================================================
# Google Maps Platform
# ============================================================
GOOGLE_MAPS_API_KEY=AIzaSy-your-google-maps-server-key
# 默认搜索半径（米），仅用于 nearby 模式
GOOGLE_MAPS_DEFAULT_RADIUS=3000
# 默认返回结果数（Places）
GOOGLE_MAPS_PLACES_LIMIT=8

# ============================================================
# Agent 行为
# ============================================================
# 默认每个研究主题最多拆解多少子任务
MAX_TASKS=5
# 默认任务并发度
TASK_CONCURRENCY=3
# 默认输出语言 (zh / en)
DEFAULT_LANGUAGE=zh

# ============================================================
# 缓存
# ============================================================
CACHE_DIR=./.cache/maps
CACHE_TTL_SECONDS=86400

# ============================================================
# Server
# ============================================================
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

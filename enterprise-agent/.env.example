# ==========================================================================
# 企业级 AI Agent 骨架 · 环境变量示例
#
# 重要：这个文件里全是**占位符**。
# 真实密钥绝不允许提交到仓库——把本文件复制为 .env 后再填写。
#   cp .env.example .env
#
# 默认配置（LLM_PROVIDER=mock + SQLite）**不需要任何 API Key 就能跑通完整流程**。
# ==========================================================================

# ---------------------------------------------------------------- 应用
APP_NAME=enterprise-agent
ENVIRONMENT=dev
DEBUG=true

# ---------------------------------------------------------------- 数据库
# 默认 SQLite，开发零依赖。
DATABASE_URL=sqlite+aiosqlite:///./enterprise_agent.db
# 切换到 PostgreSQL 只需要改这一行（并 pip install "enterprise-agent[postgres]"）：
# DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/enterprise_agent
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------- LLM
# mock / openai / anthropic
# 默认 mock：不需要外部 API Key，测试与演示完全可用。
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- OpenAI（仅在 LLM_PROVIDER=openai 时需要）---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic（仅在 LLM_PROVIDER=anthropic 时需要）---
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=2048

# ---------------------------------------------------------------- 运行时可靠性
TOOL_TIMEOUT_SECONDS=10
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=30
RETRY_JITTER_RATIO=0.2
# RUNNING 超过这个秒数无更新的步骤视为悬挂，恢复时标记 UNKNOWN 并对账。
STALE_RUNNING_SECONDS=300
# 审批超时回收（秒）。没有它，等审批的任务会永远悬着。
APPROVAL_TIMEOUT_SECONDS=86400

# ---------------------------------------------------------------- 业务规则（折扣示例）
# 普通客服自助额度
DISCOUNT_AUTO_APPROVE_MAX=0.05
# 经理审批上限；超过一律拒绝
DISCOUNT_MANAGER_APPROVE_MAX=0.15
# VIP 客户额外放宽额度（仍需过控制层）
DISCOUNT_VIP_BONUS=0.03

# ---------------------------------------------------------------- 安全 / 合规
# 生产环境必须为 true：送给 LLM 之前对上下文脱敏。
ENABLE_MASKING=true
# 策略版本号，会写进每一条 PolicyDecision，用于事后回放。
POLICY_VERSION=2026.07.1

# ---------------------------------------------------------------- 可观测性
LOG_LEVEL=INFO
# 生产建议 true，便于日志系统采集。
LOG_JSON=false
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---------------------------------------------------------------- 演示
# 生产环境设为 false。
SEED_DEMO_DATA=true
